# Real credentials for host-side MCP services, read by the mcp-*.service
# units (EnvironmentFile). Never passed into the jail - the jail reaches
# these servers by URL only.
#
# Copy to ~/.config/pi-jail/mcp.env, fill in real values, chmod 600.
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=changeme
JIRA_TOKEN=changeme
