# Environment passed into the jail by the ./pi launcher (podman --env-file).
# The agent inside the jail can read everything here - keep only gateway
# virtual keys in this file, never real API keys. LLM traffic goes through
# the gateway; credential-bearing MCP servers run on the host and the jail
# reaches them by URL.
#
# Copy to ~/.config/pi-jail/jail.env. Values must match the virtual key in
# the gateway's config.json (governance.virtual_keys, sourced from
# BIFROST_VK in bifrost.env). One variable per provider entry in models.json;
# the openai and anthropic provider entries fall back to these env vars.
OPENROUTER_API_KEY=sk-bf-pi-jail-local
ANTHROPIC_API_KEY=sk-bf-pi-jail-local
OPENAI_API_KEY=sk-bf-pi-jail-local
