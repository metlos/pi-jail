# Real upstream API keys and the jail's virtual key for the pi-jail LLM
# gateway (Bifrost).
#
# Copy to ~/.config/pi-jail/bifrost.env, fill in real values, chmod 600.
# Read by the gateway service (podman --env-file in bifrost.service) and
# sourced by .zshrc so your shell shares the same upstream keys - single
# source of truth.
#
# Values must stay zsh-source-safe: plain key material only. If a value
# ever needs spaces, quote it (KEY="some value").
#
# BIFROST_VK is the virtual key the jail authenticates with (value must
# start with sk-bf-). It is not an upstream secret, but it still only ever
# reaches the jail via jail.env - the real keys never leave this file.
OPENROUTER_API_KEY=changeme
BIFROST_VK=sk-bf-pi-jail-local
