# Real credentials for host-side mcp-atlassian service, read by the mcp-atlassian.service
# units (EnvironmentFile). Never passed into the jail - the jail reaches
# these servers by URL only.
#
# Copy to ~/.config/pi-jail/mcp-atlassian.env, fill in real values, chmod 600.
ALLOW_GLOBAL_CRED_FALLBACK=true
JIRA_URL=https://your-company.atlassian.net
JIRA_USERNAME=changeme
JIRA_API_TOKEN=changeme
