#!/usr/bin/env bash
# pj - pi-jail controller: adopts the repo layout and runs the agent jail
#
# Layout (adopted in place, repo root = PROJECT_DIR):
#   shared/home     jail home, mounted at /home by pj open/debug
#   shared/project  filled into workspaces via symlinks
#   ws/<name>       colocated jj workspaces
#   pi-jail.conf    untracked project env/PATH and workspace extra mounts
#
# Needs jj >= 0.46 (colocated workspaces, jj workspace remove).
set -euo pipefail

usage() {
	echo "usage: pj init                    adopt this jj repo into the jail layout" >&2
	echo "       pj new <ws/name>            create workspace ws/<name> and fill it from shared/project" >&2
	echo "       pj fill <ws/name>           fill ws/<name> with new shared/project entries" >&2
	echo "       pj drop [--force] <ws/name>  remove workspace (refuses on unlanded working copy)" >&2
	echo "       pj config <ws/name>         print the workspace's extra mounts (pi-jail.conf)" >&2
	echo "       pj config set <ws/name> -v <src>:<dst>[:opts]..." >&2
	echo "                                    replace the workspace's extra mounts" >&2
	echo "       pj config add <ws/name> -v <src>:<dst>[:opts]..." >&2
	echo "                                    add extra mounts to the workspace" >&2
	echo "       pj uninit [--force]         remove workspaces, restore full checkout at repo root" >&2
	echo "       pj open <ws/name> [args...] run the pi coding agent in the workspace's jail" >&2
	echo "       pj debug <ws/name>          start a shell in the workspace's jail" >&2
	exit 2
}

die() {
	echo "pj: $*" >&2
	exit 1
}

# invocation dir: pj may be cd'ed elsewhere (cd_root) before using it
inv=$PWD

# A dir is the project root when it carries the adoption marks: ws/ or
# shared/ exist, it hosts the jj repo (the default workspace's .jj/repo is
# a real dir; added workspaces carry only a pointer file), and its default
# workspace has a narrowed sparse checkout (pj init dematerializes the
# root). Layout dirs alone are not enough - shared/ is a common name.
is_root() { # is_root DIR
	[ -d "$1/ws" ] || [ -d "$1/shared" ] || return 1
	[ -d "$1/.jj/repo" ] || return 1
	local sparse
	sparse=$(cd "$1" && jj sparse list 2>/dev/null) || return 1
	[ "$sparse" != "." ]
}

# Locate the project root and make it the cwd: pj may be invoked from any
# subdir (including a workspace - its .jj is a pointer to the repo, not a
# root). The root is the nearest ancestor conforming to the pj layout (see
# is_root), the invocation dir itself included. Without one, fall back to
# the innermost real jj root (.jj/repo exists; a workspace's .jj has no
# repo dir) - adoption (pj init) has not run yet. Root-relative state
# (pi-jail.conf, ws/, shared/) then lands at the root regardless of cwd.
cd_root() {
	local dir=$PWD
	while [ "$dir" != / ]; do
		if is_root "$dir"; then
			cd "$dir" || die "cannot cd to $dir"
			return
		fi
		dir=$(dirname "$dir")
	done
	dir=$PWD
	while :; do
		if [ -d "$dir/.jj/repo" ]; then
			cd "$dir" || die "cannot cd to $dir"
			return
		fi
		[ "$dir" = / ] && break
		dir=$(dirname "$dir")
	done
	die "not a jj repo root; run from PROJECT_DIR"
}

# Resolve a workspace argument to the bare name and echo it. Two forms:
#   name form: "name" or "ws/name" (shell completion offers the latter)
#   path form: a relative path (".", "..", "x/y") resolves against the
#     invocation dir; when it lands inside the project root's ws/, the
#     workspace is the first path component below ws/ - so "pj open ."
#     inside ws/<name> opens that workspace. The name form always wins:
#     a workspace named like a dir is never shadowed.
# A name is valid only if it can never be mistaken for a pi-jail.conf
# section header line.
ws_name() { # ws_name ARG
	local name=
	case $1 in
	. | .. | ./* | ../* | */*)
		local dir
		dir=$(cd "$inv/$1" 2>/dev/null && pwd -P) || dir=
		if [ -n "$dir" ] && [ -d ws ]; then
			local root
			root=$(cd ws && pwd -P)
			case $dir/ in
				"$root"/*) [ "$dir" != "$root" ] && name=${dir#"$root"/} && name=${name%%/*} ;;
			esac
		fi
		# the path missed (e.g. "ws/name" from a sibling workspace): fall
		# back to the name form rather than dying
		[ -n "$name" ] || name=${1#ws/}
		;;
	*) name=${1#ws/} ;;
	esac
	case $name in
	"" | . | .. | \[* | *\]* | */*) die "bad workspace: $1" ;;
	env | path-prepend) die "reserved workspace name: $name (pi-jail.conf global section)" ;;
	esac
	echo "$name"
}

# Symlink shared/project into a workspace; existing entries win. Targets stay
# relative so they resolve on the host and inside the jail (the whole project
# is mounted at /work there, so paths resolve exactly as on the host).
fill_shared() {
	local ws="ws/$1"
	[ -d "$ws" ] || die "no such workspace: $ws"
	[ -d shared/project ] || return 0
	local entry link
	for entry in shared/project/* shared/project/.[!.]*; do
		[ -e "$entry" ] || continue
		link="$ws/$(basename "$entry")"
		[ -e "$link" ] || ln -s "../../$entry" "$link"
	done
}

# Unlanded user work in a workspace's working copy; symlink-only diffs are
# tolerated - those are pj's own filled entries from shared/project.
ws_dirty() {
	(cd "ws/$1" && jj diff -r @ --types) | grep -qvE '^[L-]{2} '
}

# A workspace narrowed by a stray `jj sparse set` (patterns are
# workspace-root-relative, and a clean working copy leaves no oplog trace)
# presents as an empty directory; the jail must not open on that hollow
# checkout, so restore the full pattern - and the files - first. Best
# effort: without a working jj in the workspace the jail opens as before.
ws_ensure_full() { # ws_ensure_full NAME
	local sparse
	# only real workspaces: below a plain dir, jj would resolve the root's
	# default workspace and the heal would un-narrow the root
	[ -f "ws/$1/.jj/repo" ] || return 0
	if ! sparse=$(cd "ws/$1" && jj sparse list 2>/dev/null); then
		return 0
	fi
	if [ "$sparse" != "." ]; then
		echo "note: ws/$1 was narrowed to sparse '$sparse'; resetting to full"
		(cd "ws/$1" && jj sparse set --clear --add .)
	fi
}

# Lines under [NAME] in pi-jail.conf; comments and blank lines are skipped.
# Empty output = no section / no entries.
section_lines() { # section_lines NAME
	[ -f pi-jail.conf ] || return 0
	local in_section=0 line
	while IFS= read -r line || [ -n "$line" ]; do
		line=${line%$'\r'}
		case $line in
		"[$1]") in_section=1 ;;
		\[*\]) in_section=0 ;;
		'#'*) ;;
		'') ;;
		*) [ "$in_section" -eq 1 ] && printf '%s\n' "$line" ;;
		esac
	done <pi-jail.conf
}

# Rewrite pi-jail.conf with the section's lines replaced by "$@" (or removed
# when none). Other sections, comments and blank lines are preserved as-is;
# a section that did not exist is appended at the end. No-op without a write
# when the file does not exist (drop must not create one).
write_section() { # write_section NAME [LINES...]
	local name=$1
	shift
	[ -f pi-jail.conf ] || [ $# -gt 0 ] || return 0
	local tmp=.pi-jail.conf.tmp
	local in_section=0 found=0 line
	: >"$tmp"
	if [ -f pi-jail.conf ]; then
		while IFS= read -r line || [ -n "$line" ]; do
			line=${line%$'\r'}
			case $line in
			"[$name]")
				in_section=1 found=1
				if [ $# -gt 0 ]; then # rewrite in place: header + new lines
					printf '[%s]\n' "$name" >>"$tmp"
					for spec in "$@"; do printf '%s\n' "$spec" >>"$tmp"; done
				fi
				;;
			\[*\])
				in_section=0
				printf '%s\n' "$line" >>"$tmp"
				;;
			*)
				[ "$in_section" -eq 1 ] || printf '%s\n' "$line" >>"$tmp"
				;;
			esac
		done <pi-jail.conf
	fi
	if [ "$found" -eq 0 ] && [ $# -gt 0 ]; then # section not in file yet
		[ -s "$tmp" ] && printf '\n' >>"$tmp"
		printf '[%s]\n' "$name" >>"$tmp"
		for spec in "$@"; do printf '%s\n' "$spec" >>"$tmp"; done
	fi
	mv "$tmp" pi-jail.conf
}

# A bind source must exist: podman auto-creates missing sources as
# root-owned host junk, and a typo should fail here, not on the next run.
check_specs() { # check_specs SPECS...
	local spec src
	for spec in "$@"; do
		src=${spec%%:*}
		[ -e "$src" ] || die "config: no such host path: $src"
	done
}

cmd_init() {
	cd_root
	changed=0

	# colocate so workspaces get real git worktrees (git tooling works in ws/*)
	if [ ! -d .git ]; then
		jj git colocation enable
		changed=1
	fi

	mkdir -p shared/home shared/project ws

	# bare-ish root: project files stay in commits and workspaces, not on disk
	if [ "$(jj sparse list)" != "ws" ]; then
		echo "note: project files are dematerialized from the repo root"
		jj sparse set --clear --add ws
		changed=1
	fi

	# hide layout dirs from colocated git; info/exclude is local-only
	for pat in ws/ shared/ pi-jail.conf; do
		if ! grep -qx "$pat" .git/info/exclude 2>/dev/null; then
			echo "$pat" >>.git/info/exclude
			changed=1
		fi
	done

	[ "$changed" -eq 1 ] || echo "already initialized"
}

cmd_new() {
	[ $# -eq 1 ] || usage
	cd_root
	local name
	name=$(ws_name "$1")
	[ -d .git ] || die "not initialized; run pj init first"

	# @ is a real base only while it holds pre-adoption work or a
	# description. The bare root's @ is a permanently empty placeholder
	# (sparse ws-only, nested workspaces ignored by snapshotting), and
	# basing a workspace on it bakes that empty commit into every
	# workspace's ancestry - so skip it and share @'s parents instead.
	if [ -z "$(jj log -r @ --no-graph -T description)" ] &&
		! jj diff -r @ --types | grep -q .; then
		jj workspace add --colocate "ws/$name"
	else
		# -r @: without it the new working copy lands on @'s parents (a
		# sibling of the root's current state), not on the state itself
		jj workspace add --colocate -r @ "ws/$name"
	fi

	# workspaces inherit the root's sparse pattern (ws-only); reset to full
	(cd "ws/$name" && jj sparse set --clear --add .)

	fill_shared "$name"
}

cmd_fill() {
	[ $# -eq 1 ] || usage
	cd_root
	local name
	name=$(ws_name "$1")
	fill_shared "$name"
}

cmd_drop() {
	local force=0
	if [ "${1:-}" = "--force" ]; then
		force=1
		shift
	fi
	[ $# -eq 1 ] || usage
	cd_root
	local name
	name=$(ws_name "$1")

	# jj workspace remove snapshots the working copy first, so nothing is
	# lost even with --force.
	if [ "$force" -eq 0 ] && ws_dirty "$name"; then
		die "ws/$name has unlanded work in its working copy; use --force to drop anyway"
	fi

	jj workspace remove "$name"

	# extra-mount config belongs to the workspace: a later pj new with the
	# same name should not silently resurrect the old mounts
	write_section "$name"
}

cmd_config() {
	cd_root
	local name mode
	if [ "${1:-}" = set ] || [ "${1:-}" = add ]; then
		mode=$1
		shift
	else
		mode=print
	fi
	[ $# -ge 1 ] || usage
	name=$(ws_name "$1")
	shift
	# the global $inv (invocation dir) resolves relative -v srcs; cd_root
	# and ws_name have already cd'ed us to the project root

	if [ "$mode" = print ]; then
		[ $# -eq 0 ] || usage
		local lines
		lines=$(section_lines "$name")
		[ -n "$lines" ] || die "no config for workspace: $name"
		printf '%s\n' "$lines"
		return
	fi

	declare -a specs=()
	while [ $# -gt 0 ]; do
		case $1 in
		-v | --volume)
			[ $# -ge 2 ] || usage
			specs+=("$2")
			shift 2
			;;
		--) shift; break ;;
		-*) usage ;;
		*) usage ;; # name comes first; anything else is a usage error
		esac
	done
	[ $# -eq 0 ] || usage
	[ ${#specs[@]} -gt 0 ] || usage
	# relative -v srcs resolve against the invocation dir, not the root
	local i spec src
	for i in "${!specs[@]}"; do
		spec=${specs[i]} src=${spec%%:*}
		case $src in
		/*) ;;
		*) specs[i]="$inv/$src:${spec#*:}" ;;
		esac
	done
	check_specs "${specs[@]}"

	if [ "$mode" = add ]; then # existing lines first, then the new ones
		declare -a existing=()
		while IFS= read -r line; do existing+=("$line"); done < <(section_lines "$name")
		specs=("${existing[@]}" "${specs[@]}")
	fi
	write_section "$name" "${specs[@]}"
}

# Reverse of init: remove the workspaces, restore a plain full checkout at
# the repo root. shared/ is left behind - the jail home may hold pi state
# worth keeping; rm -rf shared once done with it.
cmd_uninit() {
	local force=0
	if [ "${1:-}" = "--force" ]; then
		force=1
		shift
	fi
	[ $# -eq 0 ] || usage
	cd_root
	[ -d ws ] || [ -d shared ] || die "not an adopted repo"

	local d name
	for d in ws/*; do
		[ -d "$d" ] || continue
		name=${d#ws/}
		if [ "$force" -eq 0 ] && ws_dirty "$name"; then
			die "ws/$name has unlanded work in its working copy; use --force to uninit anyway"
		fi
	done

	# advance the root to the workspaces' landed work so the restored
	# checkout contains it (merged when heads diverged). Anchored on @'s
	# parents: workspaces are created as siblings of the root's vacuous @,
	# and dropped workspaces leave their landed chains as anonymous heads
	# in the same place. Snapshot commits of removed workspaces are
	# described by jj and survive removal on their own.
	if jj log -r 'heads(@-::) & ~@' --no-graph -T 'commit_id' | grep -q .; then
		jj new 'heads(@-::) & ~@'
	fi

	for d in ws/*; do
		[ -d "$d" ] || continue
		jj workspace remove "${d#ws/}"
	done
	rmdir ws 2>/dev/null || true

	# rematerialize the project files at the repo root
	jj sparse set --clear --add .

	# Unhide layout dirs, but keep the host-owned config excluded while left behind.
	for pat in ws/ shared/; do
		[ -f .git/info/exclude ] || continue
		grep -vx "$pat" .git/info/exclude >.git/info/exclude.tmp || true
		mv .git/info/exclude.tmp .git/info/exclude
	done

	if [ -d shared ]; then
		echo "note: shared/ left behind (jail home, shared entries); rm -rf it when you no longer need it"
	fi
}

cmd_open() {
	local name
	cd_root
	name=$(ws_name "$1")
	shift
	run_jail "$name" pi "$@"
}

cmd_debug() {
	cd_root
	local name
	name=$(ws_name "$1")
	run_jail "$name" bash
}

# Jail runner: NAME is the bare workspace name, the rest is the command line.
run_jail() { # run_jail NAME CMD [ARGS...]
	local name=$1
	shift
	cd_root

	# jail config: lives outside the image and the project mount, injected here
	# at run time (models.json mounted over the seeded stub, settings.json copied)
	local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/pi-jail"
	local f
	for f in jail.env models.json settings.json mcp.json; do
		[ -f "$cfg/$f" ] || {
			echo "pj: missing $cfg/$f - see the LLM proxy section in the pi-jail README" >&2
			exit 1
		}
	done

	# fail fast instead of letting podman auto-create missing bind sources as
	# root-owned junk on the host
	local d
	for d in .jj/repo .git "ws/$name" shared/project; do
		[ -d "$d" ] || {
			echo "pj: missing $PWD/$d - run from an initialized project root (pj init, pj new $name)" >&2
			exit 1
		}
	done

	# Validate in this shell: errors in a process-substitution producer would be lost.
	declare -a project_env=()
	local line key prefix=
	while IFS= read -r line; do
		[[ $line == *=* ]] || die "pi-jail.conf [env]: expected NAME=value assignment: $line"
		key=${line%%=*}
		[[ $key =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "pi-jail.conf [env]: invalid env name: $line"
		case $key in
		PATH) die "pi-jail.conf [env]: use [path-prepend] to preserve container PATH: $line" ;;
		PI_JAIL_PATH_PREPEND) die "pi-jail.conf [env]: reserved internal variable: $line" ;;
		esac
		project_env+=(--env "$line")
	done < <(section_lines env)
	while IFS= read -r line; do
		case $line in
		*:*) die "pi-jail.conf [path-prepend]: colon is not allowed in a directory: $line" ;;
		/*) ;;
		*) die "pi-jail.conf [path-prepend]: expected absolute container directory: $line" ;;
		esac
		prefix+="${prefix:+:}$line"
	done < <(section_lines path-prepend)
	# Always override jail.env so it cannot inject the internal carrier.
	project_env+=(--env "PI_JAIL_PATH_PREPEND=$prefix")

	ws_ensure_full "$name"

	# extra mounts for this workspace: pi-jail.conf [<name>] section at the
	# repo root, one podman -v spec per line. Appended after the fixed mounts
	# below, so they can shadow them. Validated here because hand-edits
	# bypass pj config; a missing src would otherwise make podman auto-create
	# root-owned junk on the host. The conf stays outside the jail.
	declare -a extra_vols=()
	if [ -f pi-jail.conf ]; then
		local in_section=0 line
		while IFS= read -r line || [ -n "$line" ]; do
			line=${line%$'\r'}
			case $line in
			"[$name]") in_section=1 ;;
			\[*\]) in_section=0 ;;
			'#'*) ;;
			'') ;;
			*)
				if [ "$in_section" -eq 1 ]; then
					local src=${line%%:*}
					[ -e "$src" ] || {
						echo "pj: pi-jail.conf [$name]: no such host path: $src" >&2
						exit 1
					}
					extra_vols+=("-v" "$line")
				fi
				;;
			esac
		done <pi-jail.conf
	fi

	# host VCS user config, read-only: the jail home is per-project, so without
	# this jj/git run unconfigured inside (no identity, no aliases, no ignores).
	# The whole config dirs, not single files, so includes/ inside them work.
	# Includes pointing elsewhere stay broken (git: silently ignored; jj: hard
	# error) - mount those dirs via pi-jail.conf if needed. Signing keys stay
	# out: shadow with repo-local config (git commit.gpgsign, jj signing.behavior)
	# and sign on the host when merging to main.
	declare -a vcs_vols=()
	local xdg="${XDG_CONFIG_HOME:-$HOME/.config}"
	local spec
	for spec in "$xdg/jj:/home/.config/jj" "$HOME/.gitconfig:/home/.gitconfig" "$xdg/git:/home/.config/git"; do
		if [ -e "${spec%%:*}" ]; then vcs_vols+=("-v" "$spec:ro,z"); fi
	done

	# settings are seeded per project (first run only): pi writes them inside the
	# jail (defaultModel, theme), so changes stay in this project instead of
	# mutating the person-global config
	mkdir -p "$PWD/shared/home/.pi/agent"
	cp -n "$cfg/settings.json" "$PWD/shared/home/.pi/agent/settings.json"

	# announce the extra mounts: the jail boundary differs per config, keep it
	# visible instead of silently behaving differently per repo
	if [ ${#extra_vols[@]} -gt 0 ]; then
		local dsts=" ${extra_vols[@]}"
		echo "opening jail for workspace $name (extra mounts:${dsts// -v / })"
	else
		echo "opening jail for workspace $name"
	fi

	# keep-id: rootless podman must map the host uid to itself (plain --user maps
	# it to a subuid, which owns nothing on the host). :z relabels the mounts for
	# container access under SELinux enforcing; everything else stays protected.
	#
	# Selective mounts: the jail gets only this workspace's working copy, the
	# repo data it must write to commit (.jj/repo, .git - one repository shared
	# by all workspaces, so their landed commits are visible too), and the shared
	# entries. Every reference in between (the .jj/repo and .git pointer files,
	# the ../../shared/project symlinks) is relative and resolves under this
	# mirrored /work layout exactly like on the host; other workspaces' working
	# copies and the repo root stay invisible. Jail boundary = workspace + repo
	# (+ the extra mounts above).
	#
	# The LLM proxy binds host loopback, which rootless podman blocks by default
	# (host.containers.internal points at the host's real address, not loopback),
	# so map loopback to 169.254.1.3 and repoint the name there. Side effect:
	# all host loopback services become reachable from the jail.
	podman run --rm -it \
		--userns=keep-id \
		--network=pasta:--map-host-loopback,169.254.1.3 \
		--add-host host.containers.internal:169.254.1.3 \
		--env-file "$cfg/jail.env" \
		"${project_env[@]}" \
		-v "$cfg/models.json:/home/.pi/agent/models.json:ro,z" \
		-v "$cfg/mcp.json:/home/.pi/agent/mcp.json:ro,z" \
		"${vcs_vols[@]}" \
		-v "$PWD/ws/$name:/work/ws/$name:z" \
		-v "$PWD/.jj/repo:/work/.jj/repo:z" \
		-v "$PWD/.git:/work/.git:z" \
		-v "$PWD/shared/project:/work/shared/project:z" \
		-v "$PWD/shared/home:/home:z" \
		"${extra_vols[@]}" \
		--workdir "/work/ws/$name" \
		pi-jail:latest "$@"
}

case "${1:-}" in
init) shift; [ $# -eq 0 ] || usage; cmd_init ;;
uninit) shift; cmd_uninit "$@" ;;
new) shift; cmd_new "$@" ;;
fill) shift; cmd_fill "$@" ;;
drop) shift; cmd_drop "$@" ;;
config) shift; cmd_config "$@" ;;
open) shift; [ $# -ge 1 ] || usage; cmd_open "$@" ;;
debug) shift; [ $# -eq 1 ] || usage; cmd_debug "$@" ;;
*) usage ;;
esac
